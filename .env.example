# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# ===========================================================================
# WordPress (headless CMS)
# ---------------------------------------------------------------------------
# WORDPRESS_GRAPHQL_URL: public WPGraphQL endpoint the site reads content from.
# REVALIDATE_SECRET: shared secret for POST /api/revalidate. Put the same value
#   in wp-config.php as PORTFOLIO_REVALIDATE_SECRET (and the URL as
#   PORTFOLIO_REVALIDATE_URL) so publishing in WordPress refreshes the site.
#   generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ===========================================================================
WORDPRESS_GRAPHQL_URL=https://YOUR-WORDPRESS-SITE/graphql
REVALIDATE_SECRET=change-me

# ===========================================================================
# Only needed for the one-time content migration script (npm run migrate).
# Create an Application Password in WordPress: Users -> Profile.
# Never commit real values; never expose these to the browser.
# ===========================================================================
WP_URL=https://YOUR-WORDPRESS-SITE
WP_USER=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: only for "npm run migrate -- --from-supabase"
SUPABASE_URL=
SUPABASE_ANON_KEY=
